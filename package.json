{
  "name": "@nredd/pi-plan-mode",
  "version": "0.58.0-nredd.2",
  "description": "Pi extension that adds a Codex-like read-only /plan collaboration mode. Fork of @narumitw/pi-plan-mode with a compact status widget and a rendered plan_mode_question result.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "plan-mode",
    "planning"
  ],
  "files": [
    "src",
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.ts"
    ]
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "check": "npm run build && biome check . && npm run typecheck && npm run test",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nredd/pi-plan-mode"
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.59.0"
  }
}
